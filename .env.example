# Week 5: Website -> WhatsApp lead-intent tracking (server-only; never prefix with NEXT_PUBLIC_).
# Google Apps Script web app URL (ends in /exec) that logs "WhatsApp Click" / "Lead Intent" events to the
# leads Google Sheet and emails the team. Must start with https://script.google.com/.
LEAD_SINK_URL=
# Shared secret, sent in the JSON body. Must match the LEAD_SINK_SECRET Script Property in Apps Script.
LEAD_SINK_SECRET=

# Week 5 stretch: WhatsApp qualification bot (server-only; never prefix with NEXT_PUBLIC_).
# The bot is OFF unless this is exactly "true". Leave it false in Production.
WHATSAPP_BOT_ENABLED=false
# Auth token of the Twilio account that owns the bot's sender (use a separate Sandbox account, not production).
TWILIO_AUTH_TOKEN=
# Exact public webhook URL configured in Twilio (used to verify X-Twilio-Signature). No #fragment.
TWILIO_WEBHOOK_URL=
# Optional: Account SID (AC...) expected on incoming webhooks.
TWILIO_ACCOUNT_SID=
# Number the bot answers on, e.g. whatsapp:+14155238886 for the Twilio Sandbox.
WHATSAPP_BOT_TO=
# Human/team number given to the guest at handoff, in international format.
WHATSAPP_HANDOFF_NUMBER=
# Optional. Groq is only a fallback to extract fields the rule-based parser cannot read; without it the bot
# still works. It never writes replies or decides anything.
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-20b.
GROQ_MODEL=
# Upstash Redis REST credentials for conversation state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Week 5 stretch: qualified WhatsApp leads and team handoffs from the bot (server-only; never NEXT_PUBLIC_).
# Google Apps Script web app URL (ends in /exec; normally the same deployment as LEAD_SINK_URL). Must start with
# https://script.google.com/. Writes the "Qualified Leads" and "Handoffs" tabs and emails the team.
QUALIFIED_LEAD_SINK_URL=
# Separate shared secret, sent in the JSON body. Must match the QUALIFIED_LEAD_SINK_SECRET Script Property.
QUALIFIED_LEAD_SINK_SECRET=

# Week 6 Stretch 2, Phase A: automatic WhatsApp follow-up CHECK endpoint, /api/whatsapp/follow-up (server-only;
# never NEXT_PUBLIC_). DRY RUN ONLY: it never sends a message. OFF (404) unless this is exactly "true".
# Uses the same UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN as the bot (read opt-outs, one claim per lead).
WHATSAPP_FOLLOW_UP_ENABLED=false
# Shared secret (at least 32 characters). Must match the WA_FOLLOW_UP_SECRET Script Property.
WHATSAPP_FOLLOW_UP_SECRET=
# LIVE follow-ups (mode "live" sends ONE approved WhatsApp template per lead). DISABLED BY DEFAULT: leave false.
# Live is refused (409) unless ALL of these hold: this is exactly "true", WHATSAPP_BOT_ENABLED=true with a valid
# bot configuration (so STOP replies are recorded), TWILIO_ACCOUNT_SID is set, and WHATSAPP_FOLLOW_UP_CONTENT_SID is
# set. Messages are sent from WHATSAPP_BOT_TO using TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN. Each lead is followed up
# at most once (ever), and each guest number at most once per 30 days.
WHATSAPP_FOLLOW_UP_LIVE_ENABLED=false
# REQUIRED for live: Content SID (HX + 32 hex) of a WhatsApp template that Meta has APPROVED (Twilio Content
# Template Builder). Business-initiated messages outside the 24-hour window must use an approved template. There is
# no default: without it live is refused.
WHATSAPP_FOLLOW_UP_CONTENT_SID=
# Optional: template variables -> guest-safe lead fields only (destination, property, checkIn, checkOut).
# Example: 1=destination,2=property,3=checkIn,4=checkOut. Leave empty for a template without variables.
# property is sent as the website's display name for that property, or "our stays" when the lead has none.
WHATSAPP_FOLLOW_UP_CONTENT_VARIABLES=

# Week 7: Guest Messages (server-only; never prefix with NEXT_PUBLIC_). Nothing in Week 7 messages a guest: due
# pre-arrival / check-in / checkout messages go to the team's "Guest Messages" tab, and guest questions the FAQ cannot
# answer go to "Guest Escalations" + a team email.
# Intellistay PMS: ONLY the TEST server is supported. The production host (*.intellistay.in) is refused in code.
INTELLISTAY_ENV=test
INTELLISTAY_BASE_URL=https://ritumbharatest.aastratech.com
INTELLISTAY_USERNAME=
INTELLISTAY_PASSWORD=
# Branch to read bookings for (the test account's branch is 1).
INTELLISTAY_BRANCH_ID=
# /api/guest-messages/run and /api/guest-messages/ask are OFF (404) unless this is exactly "true".
GUEST_MESSAGES_ENABLED=false
# Shared secret (at least 32 characters) the callers send as "Authorization: Bearer ...". Must match the
# GUEST_MESSAGES_API_SECRET Script Property (Apps Script calls /run daily).
GUEST_MESSAGES_API_SECRET=
# Google Apps Script web app URL (ends in /exec; normally the same deployment as QUALIFIED_LEAD_SINK_URL). Must start
# with https://script.google.com/. Writes the "Guest Messages" and "Guest Escalations" tabs.
GUEST_MESSAGES_SINK_URL=
# Separate shared secret, sent in the JSON body. Must match the GUEST_MESSAGES_SINK_SECRET Script Property.
GUEST_MESSAGES_SINK_SECRET=
