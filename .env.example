# Week 5: Website -> WhatsApp lead-intent tracking (server-only; never prefix with NEXT_PUBLIC_).
# n8n webhook that receives "WhatsApp Click" / "Lead Intent" events from /api/wa-click.
N8N_LEAD_WEBHOOK_URL=
# Shared secret sent to n8n in the X-Webhook-Secret header (configure n8n Header Auth to check it).
N8N_LEAD_WEBHOOK_SECRET=
